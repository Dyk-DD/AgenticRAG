# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密钥。

# ==================== LLM API ====================
# DeepSeek 控制台申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 生成模型。**必须是非推理模型**（如 deepseek-chat），不要用推理模型
# （deepseek-reasoner / deepseek-v4-flash 一类）。
#
# 原因：推理模型先输出 reasoning_content（思考）再输出正文，二者共用同一个
# max_tokens 预算。本仓库没有任何一处读 reasoning_content，所以预算被思考吃光时
# 正文会是空字符串，且不会抛任何异常 —— 表现为"只返回一句免责声明"的空答案、
# 路由与关键词抽取的 JSON 解析失败（进而使双层检索恒返回 0 条）。
# 详细说明见 app/config.py 中 llm_model 处的注释。
LLM_MODEL=deepseek-chat

# 生成模型的输出上限。注意调用方必须显式传递才生效（见 app/main.py）。
# LLM_MAX_TOKENS=4096

# ==================== 访问控制 ====================
# 访问系统的全局密码。留空时后端默认拒绝服务（fail closed），
# 仅当显式设置 ALLOW_NO_AUTH=1 才会放行全部接口（仅供本机调试）。
ACCESS_PASSWORD=

# 令牌签名密钥。用于签发访问令牌与患者身份令牌，泄露即等于可伪造任意身份。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时会退化为从 ACCESS_PASSWORD 派生，两者任一变更都会使已签发令牌失效。
SECRET_KEY=

# 设为 1 可跳过全局访问密码校验（切勿在公网环境启用）
# ALLOW_NO_AUTH=0

# ==================== 邮件验证码 ====================
# 注册与忘记密码靠邮件验证码。整节留空 = 未配置：账号仍可登录，但注册与
# 密码重置会返回 503。改完这节重启 api 容器即生效（app/mailer.py 按调用读环境）。
SMTP_HOST=
# 465 配 SMTP_SECURITY=ssl（默认）；587 配 starttls。
# SMTP_PORT=465

# ssl | starttls | none。
#   ssl      = 连上即 TLS（465 的出荷配置）
#   starttls = 明文连接后升级（587）
#   none     = 全程明文，且每次发送记一条 warning。**仅供本机对着 sink 演练，
#              不要用于任何真实部署** —— 授权码会以明文过网。
# SMTP_SECURITY=ssl

# 完整的发信邮箱地址，同时用作 From。
SMTP_USER=

# 邮箱**授权码**，不是邮箱登录密码。QQ/163 都要求在网页版设置里单独开启 SMTP
# 并生成授权码；填邮箱密码会以一条看不出原因的 AUTH 失败告终。
# 生成的授权码只填在这里，切勿提交 .env。
SMTP_PASSWORD=

# 收件人看到的发信人显示名，可留空。
# SMTP_FROM_NAME=

# 单次 SMTP 操作的超时（秒）。**不要调大**：发信端点与 /api/chat 共用同一个
# 线程池（Dockerfile 钉死 --workers 1），一个挂住的邮件服务器会连带饿死聊天。
# SMTP_TIMEOUT_SECONDS=10

# 下面五项是发信与验码的限额，键都按「规范化邮箱」或「客户端 IP」算。
# 注意：计数器在进程内存里，重启容器即归零 —— 重启不会被攻击者触发，可以接受；
# 真正防猜测的 5 次尝试上限在 SQLite 的 email_codes 表里，重启不丢。
# 个人 QQ/163 邮箱每日发信上限很低（常远低于 100），别把日限额设到它之上，
# 否则用户会看到看似 bug 的 502。

# 两次发码之间的最短间隔（秒），下发给前端做倒计时
# EMAIL_CODE_RESEND_SECONDS=60
# 同一邮箱每小时的发码上限
# EMAIL_SEND_MAX_PER_EMAIL_HOUR=3
# 同一邮箱每日的发码上限（真正卡住暴力猜码的是这一项）
# EMAIL_SEND_MAX_PER_EMAIL_DAY=10
# 同一 IP 每日的发码上限
# EMAIL_SEND_MAX_PER_IP_DAY=30
# 同一 IP 每小时可提交的验码次数（不论是否存在有效码）
# EMAIL_VERIFY_MAX_PER_IP_HOUR=30

# 验证码有效期（600 秒）与单个码的尝试次数上限（5 次）写在
# app/qa_database.py 的常量里，不是环境变量 —— 它们与「先消费再建账号」
# 的顺序耦合，改之前请先读那里的注释。

# ==================== Neo4j ====================
# 由 docker-compose.yml 与 app/config.py 共同读取。未设置时 compose 会直接报错。
NEO4J_URI=bolt://localhost:8687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ==================== Milvus ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== 其他 ====================
# HuggingFace 镜像（国内加速下载模型）
HF_ENDPOINT=https://hf-mirror.com

# ==================== Cloudflare Tunnel ====================
# Zero Trust 控制台创建隧道后拿到的令牌。为空时 cloudflared 服务不会启动。
# 生成方式见 README「公网部署」一节。
TUNNEL_TOKEN=

# ==================== CORS ====================
# 逗号分隔。同源部署下 CORS 不会被触发，留空即用默认值
# （开发用 5173 + 旧的 GitHub Pages 源）。
# CORS_ORIGINS=
